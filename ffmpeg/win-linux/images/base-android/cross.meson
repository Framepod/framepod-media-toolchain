[binaries]
c = 'aarch64-linux-android24-clang'
cpp = 'aarch64-linux-android24-clang++'
ar = 'llvm-ar'
ranlib = 'llvm-ranlib'
strip = 'llvm-strip'
nm = 'llvm-nm'

[properties]
# Target binaries are arm64 Android; nothing here can run them.
needs_exe_wrapper = true

[host_machine]
system = 'android'
cpu_family = 'aarch64'
cpu = 'aarch64'
endian = 'little'
