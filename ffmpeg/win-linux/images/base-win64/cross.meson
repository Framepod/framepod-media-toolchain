[binaries]
c = 'x86_64-w64-mingw32-gcc'
cpp = 'x86_64-w64-mingw32-g++'
ar = 'x86_64-w64-mingw32-gcc-ar'
ranlib = 'x86_64-w64-mingw32-gcc-ranlib'
strip = 'x86_64-w64-mingw32-strip'
windres = 'x86_64-w64-mingw32-windres'
dlltool = 'x86_64-w64-mingw32-dlltool'

[properties]
# Upstream also sets exe_wrapper = ['wine'], which only works on an x86_64 host:
# on arm64 the container's wine is aarch64-windows only and meson's sanity check
# hard-fails. Declaring that a wrapper is needed but supplying none makes meson
# skip run-time checks instead of attempting them, on either host.
needs_exe_wrapper = true

[host_machine]
system = 'windows'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
