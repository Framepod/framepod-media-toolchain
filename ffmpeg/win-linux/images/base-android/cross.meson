[binaries]
c = '@ANDROID_TRIPLE@24-clang'
cpp = '@ANDROID_TRIPLE@24-clang++'
ar = 'llvm-ar'
ranlib = 'llvm-ranlib'
strip = 'llvm-strip'
nm = 'llvm-nm'

[properties]
# Target binaries are arm64 Android; nothing here can run them.
needs_exe_wrapper = true

[host_machine]
system = 'android'
cpu_family = '@MESON_CPU_FAMILY@'
cpu = '@MESON_CPU_FAMILY@'
endian = 'little'
